# URL du serveur temps réel (apps/server)
VITE_SERVER_URL=http://localhost:4001

# ─── Sauvegarde en ligne du profil (Google) — OPTIONNEL ───────────────
# Sans ces variables, l'app reste 100 % locale (le bouton Google est masqué).
#
# Mise en place (5 min, gratuit) :
#  1. https://console.firebase.google.com → Créer un projet (ex. dominos-clan)
#  2. Authentication → Get started → Sign-in method → Google → Activer
#  3. Firestore Database → Créer (mode production), puis onglet Règles :
#       rules_version = '2';
#       service cloud.firestore {
#         match /databases/{database}/documents {
#           match /users/{uid} {
#             allow read, write: if request.auth != null && request.auth.uid == uid;
#           }
#         }
#       }
#  4. Paramètres du projet → Vos applications → Ajouter une app Web (</>)
#     → copier les valeurs ci-dessous
#  5. Authentication → Settings → Domaines autorisés → ajouter
#     dominos-clan.onrender.com (localhost y est déjà)
#
# Ces clés ne sont PAS des secrets (elles sont visibles dans le bundle web) :
# la sécurité vient des règles Firestore ci-dessus.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
