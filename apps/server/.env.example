# Port HTTP (Render fournit le sien automatiquement)
PORT=4001

# Répertoire du client web buildé (défini par le Dockerfile en prod)
# STATIC_DIR=/app/apps/web/dist

# Chat vocal LiveKit — laisser vide pour désactiver la voix.
# Compte gratuit : https://cloud.livekit.io (Settings -> Keys)
LIVEKIT_URL=wss://<ton-projet>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
